# Test Environment
NODE_ENV=test
APP_NAME=RecruitPro
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:4200
API_PREFIX=api/v1
API_VERSION=1

# Database (separate test database)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=recruitpro
DATABASE_PASSWORD=recruitpro_dev_password
DATABASE_NAME=recruitpro_test
DATABASE_URL=postgresql://recruitpro:recruitpro_dev_password@localhost:5432/recruitpro_test?schema=public

# Redis (separate DB index)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# JWT
JWT_ACCESS_SECRET=test-access-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=test-refresh-secret
JWT_REFRESH_EXPIRATION=7d

# Email (disabled in tests)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@test.recruitpro.local
MAIL_SECURE=false

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./test-uploads

# Rate Limiting (relaxed for tests)
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Logging
LOG_LEVEL=error
LOG_FORMAT=json

# CORS
CORS_ORIGINS=http://localhost:4200

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
