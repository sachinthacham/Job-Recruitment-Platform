# Development Environment
NODE_ENV=development
APP_NAME=RecruitPro
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
API_PREFIX=api/v1
API_VERSION=1

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=recruitpro
DATABASE_PASSWORD=recruitpro_dev_password
DATABASE_NAME=recruitpro
DATABASE_URL=postgresql://recruitpro:recruitpro_dev_password@localhost:5432/recruitpro?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=dev-access-secret-not-for-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev-refresh-secret-not-for-production
JWT_REFRESH_EXPIRATION=7d

# Email (MailHog for local dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@recruitpro.local
MAIL_SECURE=false

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# CORS
CORS_ORIGINS=http://localhost:4200

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
