# ============================================================
# Application
# ============================================================
NODE_ENV=development
APP_NAME=RecruitPro
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
API_PREFIX=api/v1
API_VERSION=1

# ============================================================
# Database (PostgreSQL)
# ============================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=recruitpro
DATABASE_PASSWORD=recruitpro_dev_password
DATABASE_NAME=recruitpro
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public

# ============================================================
# Redis
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ============================================================
# JWT Authentication
# ============================================================
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRATION=7d

# ============================================================
# Email (SMTP)
# ============================================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@recruitpro.com
MAIL_SECURE=false

# ============================================================
# File Storage
# ============================================================
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# AWS S3 (when STORAGE_DRIVER=s3)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================
# OAuth (optional)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/v1/auth/linkedin/callback

# ============================================================
# Rate Limiting
# ============================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:4200

# ============================================================
# File Upload Limits
# ============================================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================================
# Payment (abstracted)
# ============================================================
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
